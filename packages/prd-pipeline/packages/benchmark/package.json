{
  "name": "@agentic/prd-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./calibration": {
      "import": "./dist/calibration/index.js",
      "types": "./dist/calibration/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.calibration.json",
    "clean": "rm -rf dist",
    "bench": "node dist/runner.js",
    "calibrate:gates": "node dist/calibration/calibration/calibrate-gates.js"
  },
  "dependencies": {
    "@agentic/prd-core": "workspace:*",
    "@agentic/prd-orchestration": "workspace:*",
    "@agentic/prd-validation": "workspace:*",
    "ajv": "^8.17.1",
    "mathjs": "^15.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}

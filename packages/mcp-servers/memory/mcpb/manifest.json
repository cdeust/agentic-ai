{
  "manifest_version": "0.3",
  "name": "agentic-memory",
  "display_name": "Agentic Memory (Cortex)",
  "version": "0.3.1",
  "description": "Cortex thermodynamic memory for Claude Desktop — local-first, zero-config SQLite. Remember/recall with hybrid WRRF retrieval, FlashRank reranking, knowledge-graph entities, methodology profiling, and a wiki. 48 tools, no external service required.",
  "long_description": "Native Node.js MCP server exposing the full @agentic/memory engine over stdio. Defaults to an embedded SQLite store (sqlite-vec + FTS5) at ~/.cortex/cortex.db — no PostgreSQL, no API key needed; an ANTHROPIC_API_KEY (or Claude Desktop MCP sampling) only enables LLM-assisted entity extraction. Set DATABASE_URL to use a PostgreSQL/pgvector backend instead. Set CORTEX_DB_PATH to relocate the SQLite database.",
  "author": {
    "name": "Clément Deust",
    "url": "https://github.com/cdeust"
  },
  "homepage": "https://ai-architect.tools",
  "documentation": "https://github.com/cdeust/Cortex",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {}
    }
  },
  "tools": [
    { "name": "remember" },
    { "name": "recall" },
    { "name": "recall_hierarchical" },
    { "name": "unified_search" },
    { "name": "anchor" },
    { "name": "forget" },
    { "name": "rate_memory" },
    { "name": "validate_memory" },
    { "name": "memory_stats" },
    { "name": "consolidate" },
    { "name": "assess_coverage" },
    { "name": "detect_gaps" },
    { "name": "backfill_memories" },
    { "name": "import_sessions" },
    { "name": "record_session_end" },
    { "name": "checkpoint" },
    { "name": "narrative" },
    { "name": "get_project_story" },
    { "name": "get_causal_chain" },
    { "name": "navigate_memory" },
    { "name": "drill_down" },
    { "name": "change_impact" },
    { "name": "query_methodology" },
    { "name": "rebuild_profiles" },
    { "name": "detect_domain" },
    { "name": "list_domains" },
    { "name": "explore_features" },
    { "name": "get_telemetry" },
    { "name": "add_rule" },
    { "name": "get_rules" },
    { "name": "create_trigger" },
    { "name": "sync_instructions" },
    { "name": "seed_project" },
    { "name": "ingest_codebase" },
    { "name": "ingest_prd" },
    { "name": "codebase_analyze" },
    { "name": "query_workflow_graph" },
    { "name": "get_methodology_graph" },
    { "name": "open_visualization" },
    { "name": "curate_wiki" },
    { "name": "wiki_write" },
    { "name": "wiki_read" },
    { "name": "wiki_list" },
    { "name": "wiki_link" },
    { "name": "wiki_adr" },
    { "name": "wiki_verify" },
    { "name": "wiki_reindex" },
    { "name": "wiki_purge" }
  ],
  "keywords": ["memory", "cortex", "knowledge-graph", "rag", "sqlite", "embeddings", "methodology"],
  "license": "MIT",
  "privacy_policies": ["https://github.com/cdeust/Cortex/blob/main/PRIVACY.md"],
  "compatibility": {
    "platforms": ["darwin", "linux"],
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}

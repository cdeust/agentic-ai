{
  "name": "@agentic/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Cortex memory subsystem: recall, remember, consolidation, hooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./recall": {
      "types": "./dist/recall/index.d.ts",
      "import": "./dist/recall/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "yaml": "^2.4.0",
    "better-sqlite3": "^12.0.0",
    "pg": "^8.11.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/better-sqlite3": "^7.6.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

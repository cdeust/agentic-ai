{
  "name": "@agentic/memory-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP dashboard server for the 3D constellation map — TS port of cortex@ed33435 mcp_server/server/",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./launcher": {
      "import": "./dist/launcher.js",
      "types": "./dist/launcher.d.ts"
    }
  },
  "bin": {
    "memory-dashboard": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "@fastify/static": "^8.1.0",
    "@fastify/cors": "^11.0.0",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^25.6.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}

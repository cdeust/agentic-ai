{
  "name": "Zetetic Agents",

  // Python 3.12 + Node 20 LTS on Debian Bookworm.
  // Node is required for Claude Code (npm install -g @anthropic-ai/claude-code).
  // Python 3.12 is current stable; hooks are stdlib-only so no version
  // sensitivity beyond 3.9+.  We pin to microsoft/devcontainers rather than
  // a floating tag so the image is reproducible.
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    // Node 20 LTS — required for Claude Code CLI install via npm.
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },

    // git 2.x — for pre-commit-zetetic.sh (git diff --cached).
    "ghcr.io/devcontainers/features/git:1": {},

    // Common utilities: jq (required by pre-commit-zetetic.sh JSON parse path),
    // ripgrep (used by zetetic-checker.sh and genius agents), curl, bash 5.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },

  // postCreateCommand runs once when the container is first created.
  // It installs all external dependencies and runs setup.sh so that
  // CLAUDE_PLUGIN_ROOT, hooks, agents, and commands are all live before
  // the user's first terminal session.
  //
  // Step-by-step:
  //   1. jq + ripgrep — needed by hooks and zetetic-checker.sh
  //   2. pre-commit — needed by postCreateCommand demo-audit clone below
  //   3. Claude Code CLI — the CLI the agents run inside
  //   4. setup.sh install — copies agents/skills/commands to ~/.claude,
  //      merges hooks.json into plugin.json
  //   5. Write CLAUDE_PLUGIN_ROOT to /etc/environment so it persists
  //      across all terminal sessions (not just the build step)
  //   6. Clone adam-epsilon demo audit target — a real paper-code mismatch
  //      (Kingma & Ba 2015, epsilon=1e-8 vs common impl epsilon=1e-7)
  "postCreateCommand": "sudo apt-get install -y --no-install-recommends jq ripgrep && pip install --quiet pre-commit && npm install -g @anthropic-ai/claude-code --quiet && bash scripts/setup.sh install && echo 'CLAUDE_PLUGIN_ROOT=/workspaces/zetetic-team-subagents' | sudo tee -a /etc/environment && git clone --quiet --depth=1 https://github.com/cdeust/adam-epsilon-demo /workspaces/demo-audit 2>/dev/null || true",

  // postStartCommand runs every time the container starts (including after
  // resume).  It displays the welcome banner: a live self-audit of the
  // dev container's own hook scripts, followed by a one-line proof that
  // the commit gate fires and two ceiling-raising one-liners.
  //
  // The banner is NOT a help message — it is a demonstration.
  "postStartCommand": "bash /workspaces/zetetic-team-subagents/.devcontainer/welcome.sh",

  "secrets": {
    // Injected from the Codespace secret store.  The user must add
    // ANTHROPIC_API_KEY under Settings > Secrets > Codespaces before
    // opening this Codespace.  Without it, Claude Code starts but
    // cannot call the API; all hook machinery still works.
    "ANTHROPIC_API_KEY": {}
  },

  "remoteEnv": {
    // Make CLAUDE_PLUGIN_ROOT available to every process including
    // Claude Code sub-shells.  /etc/environment covers login shells;
    // remoteEnv covers VS Code's own process tree.
    "CLAUDE_PLUGIN_ROOT": "/workspaces/zetetic-team-subagents"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Claude Code VS Code extension — provides /genius route and
        // slash commands in the command palette.
        "anthropic.claude-code"
      ],
      "settings": {
        // Open terminal on container start so the welcome banner is
        // the first thing the user sees.
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.shellIntegration.enabled": true,
        "workbench.startupEditor": "terminal",

        // Disable telemetry in a shared demo environment.
        "telemetry.telemetryLevel": "off",

        // Python: point at the system interpreter that has pre-commit
        // and the zetetic hook dependencies.
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },

  // Forward no ports by default.  If the user runs a local web tool
  // (e.g., live-preview.sh), Codespaces will auto-detect the port.
  "forwardPorts": [],

  // Run as the default non-root vscode user.
  "remoteUser": "vscode"
}

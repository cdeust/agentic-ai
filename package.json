{
  "name": "agentic-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Unified TS monorepo: memory + codebase + reasoning + PRD pipeline. Anthropic agent SDK + MCP.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "parity": "vitest run --config parity-oracle/vitest.parity.config.ts",
    "layer-check": "tsx scripts/check-layer-imports.ts",
    "layer-check:self-test": "tsx scripts/check-layer-imports.ts --self-test",
    "source-citation-check": "bash scripts/check-source-citations.sh",
    "audit-migration": "bash scripts/audit-migration.sh",
    "prepare": "husky",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm lint && pnpm typecheck && pnpm layer-check && pnpm test && pnpm parity",
    "spawn": "./scripts/spawn-worktree.sh",
    "worktrees": "git worktree list"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "madge": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

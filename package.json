{
  "name": "architect-os",
  "version": "0.1.0",
  "private": true,
  "description": "Four-tier MCP architecture: proxy, gateway, intent services with sandboxed agent workers, typed data layer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/sandbox",
    "data",
    "gateway",
    "services/memory"
  ],
  "scripts": {
    "code": "node --import tsx packages/sandbox/src/code.ts",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:features": "cucumber-js",
    "arch": "depcruise --config .dependency-cruiser.cjs packages data gateway services",
    "lint": "npm run format:check --silent && npm run typecheck --silent",
    "check": "npm run typecheck && npm run format:check && npm run test && npm run test:features && npm run arch"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/gherkin": "38.0.0",
    "@cucumber/messages": "32.3.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/cucumber-runner": "10.1.1",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}

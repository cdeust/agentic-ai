{
  "name": "agentic-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Unified TS monorepo: memory + codebase + reasoning + PRD pipeline. Anthropic agent SDK + MCP.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "parity": "vitest run --config parity-oracle/vitest.parity.config.ts",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm lint && pnpm test",
    "spawn": "./scripts/spawn-worktree.sh",
    "worktrees": "git worktree list"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
